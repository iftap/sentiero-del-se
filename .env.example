# ====================================================================
# SENTIERO DEL SÉ — Environment Configuration Example
# ====================================================================

# Canonical PostgreSQL Connection String
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sentiero_del_se?schema=public"

# Authentication Secret (Used for signing sessions / JWTs)
# Generate in production using: openssl rand -base64 32
AUTH_SECRET="super-secret-auth-key-change-this-in-production-must-be-at-least-32-bytes"

# Base URL for the Application
NEXTAUTH_URL="http://localhost:3000"

# Application Environment
NODE_ENV="development"
